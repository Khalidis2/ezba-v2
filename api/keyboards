# api/keyboards.py


def button(text, data):
    return {"text": text, "callback_data": data}


def rows(buttons, width=2):
    return [buttons[i:i + width] for i in range(0, len(buttons), width)]


def markup(button_rows):
    return {"inline_keyboard": button_rows}


def main_menu():
    return markup([
        [button("➕ عملية جديدة", "main:new")],
        [button("📦 الجرد", "main:inventory"), button("📊 التقارير", "main:reports")],
        [button("🏠 الرئيسية", "main:home")],
    ])


def operation_menu():
    return markup([
        [button("💰 بيع", "op:sale"), button("🛒 شراء", "op:buy")],
        [button("💸 مصروف", "op:expense")],
        [button("⬅️ رجوع", "main:home"), button("❌ إلغاء", "cancel")],
    ])


def inventory_items(items):
    buttons = []
    for item in items[:30]:
        name = item.get("الصنف", "")
        item_id = item.get("رقم الصنف", "")
        if name and item_id:
            buttons.append(button(name, f"item:{item_id}"))
    button_rows = rows(buttons, 2)
    button_rows.append([button("➕ صنف آخر", "item:custom")])
    button_rows.append([button("⬅️ رجوع", "main:new"), button("❌ إلغاء", "cancel")])
    return markup(button_rows)


