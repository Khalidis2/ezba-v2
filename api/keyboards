def payment_status_menu(payment):
    if payment == "آجل":
        return markup([
            [button("غير مدفوع", "pstat:غير مدفوع")],
            [button("مدفوع جزئياً", "pstat:مدفوع جزئياً")],
            [button("❌ إلغاء", "cancel")],
        ])
    return markup([
        [button("مدفوع", "pstat:مدفوع")],
        [button("مدفوع جزئياً", "pstat:مدفوع جزئياً")],
        [button("❌ إلغاء", "cancel")],
    ])


def people_menu(people, allow_none=True):
    buttons = []
    for person in people[:30]:
        name = person.get("الاسم", "")
        person_id = person.get("رقم الشخص", "")
        if name and person_id:
            buttons.append(button(name, f"party:{person_id}"))
    button_rows = rows(buttons, 2)
    if allow_none:
        button_rows.append([button("بدون", "party:none")])
    button_rows.append([button("➕ جديد", "party:new")])
    button_rows.append([button("❌ إلغاء", "cancel")])
    return markup(button_rows)


